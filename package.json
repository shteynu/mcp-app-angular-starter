{
  "name": "mcp-app-angular-starter",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:view && npm run build:server",
    "build:view": "node scripts/build-view.mjs",
    "build:server": "tsc -p tsconfig.server.json && esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "dev": "npm run build:server && node scripts/build-view.mjs --watch --serve",
    "start": "node dist/server/index.js",
    "start:stdio": "node dist/server/index.js --stdio",
    "check": "node scripts/check.mjs",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "description": "Basic MCP App starter with an Angular UI, built with the plain Angular CLI",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  }
}
